From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alex Garcia <lex@ibm.com>
Date: Tue, 18 Aug 2026 07:51:22 -0500
Subject: agent host: ignore the disableAIFeatures setting

`chat.disableAIFeatures` defaults to true in VSCodium, and the agent host enablement service required it to be off, so the Agents window never started a local agent host. Enablement now follows `chat.agentHost.enabled` alone, leaving the built-in Copilot UI hidden behind the setting as before.

diff --git a/src/vs/platform/agentHost/browser/agentHostEnablementService.ts b/src/vs/platform/agentHost/browser/agentHostEnablementService.ts
index d99cd5e46afc5d9531485e8750c3a82f6129d44d..998b79f3a487a44f25d8dae2140b4b7e4a596ebd 100644
--- a/src/vs/platform/agentHost/browser/agentHostEnablementService.ts
+++ b/src/vs/platform/agentHost/browser/agentHostEnablementService.ts
@@ -7,7 +7,6 @@ import { Disposable } from '../../../base/common/lifecycle.js';
 import { IObservable, observableValue } from '../../../base/common/observable.js';
 import { isWeb } from '../../../base/common/platform.js';
 import { ConfigurationTarget, IConfigurationService } from '../../configuration/common/configuration.js';
-import { ChatAIDisabledSettingId } from '../../chat/common/chatSettings.js';
 import { IContextKey, IContextKeyService } from '../../contextkey/common/contextkey.js';
 import { InstantiationType, registerSingleton } from '../../instantiation/common/extensions.js';
 import { AGENT_HOST_ENABLED_CONTEXT_KEY, IAgentHostEnablementService } from '../common/agentHostEnablementService.js';
@@ -37,10 +36,7 @@ export class AgentHostEnablementService extends Disposable implements IAgentHost
 		this._enabledContextKey.set(this.enabled.get());
 
 		this._register(configurationService.onDidChangeConfiguration(event => {
-			if (
-				(event.source === ConfigurationTarget.DEFAULT && event.affectsConfiguration(agentHostEnabledSettingId))
-				|| event.affectsConfiguration(ChatAIDisabledSettingId)
-			) {
+			if (event.source === ConfigurationTarget.DEFAULT && event.affectsConfiguration(agentHostEnabledSettingId)) {
 				this._updateEnabled(configurationService);
 			}
 		}));
@@ -48,8 +44,7 @@ export class AgentHostEnablementService extends Disposable implements IAgentHost
 
 	private _readEnabled(configurationService: IConfigurationService): boolean {
 		return this._isAgentHostRuntimeAvailable
-			&& (configurationService.getValue<boolean>(agentHostEnabledSettingId) ?? false)
-			&& configurationService.getValue<boolean>(ChatAIDisabledSettingId) !== true;
+			&& (configurationService.getValue<boolean>(agentHostEnabledSettingId) ?? false);
 	}
 
 	private _updateEnabled(configurationService: IConfigurationService): void {
