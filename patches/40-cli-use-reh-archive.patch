+fn get_env_or(name: &str, built_in: Option<&'static str>) -> Option<String> {
+	match std::env::var(name) {
+		Ok(value) if !value.is_empty() => Some(value),
+		_ => built_in
+			.filter(|value| !value.is_empty())
+			.map(|value| value.to_string()),
+	}
+}
+
+fn get_built_release(platform: Platform, target: TargetKind) -> Result<Option<Release>, CodeError> {
+	let (Some(commit), Some(quality)) = (
+		get_env_or("VSCODE_CLI_COMMIT", VSCODE_CLI_COMMIT),
+		get_env_or("VSCODE_CLI_QUALITY", VSCODE_CLI_QUALITY),
+	) else {
+		return Ok(None);
+	};
+
+	let quality = options::Quality::try_from(quality.as_str())
+		.map_err(|_| CodeError::UpdatesNotConfigured("unknown VSCODE_CLI_QUALITY"))?;
+
+	Ok(Some(Release {
+		name: String::new(),
+		platform,
+		target,
+		quality,
+		commit,
+	}))
+}
+
+fn get_download_url_template(target: TargetKind) -> Result<String, CodeError> {
+	match target {
+		TargetKind::Server => get_env_or(
+			"VSCODE_CLI_SERVER_DOWNLOAD_URL_TEMPLATE",
+			VSCODE_CLI_SERVER_DOWNLOAD_URL_TEMPLATE,
+		),
+		TargetKind::Web => get_env_or(
+			"VSCODE_CLI_SERVER_WEB_DOWNLOAD_URL_TEMPLATE",
+			VSCODE_CLI_SERVER_WEB_DOWNLOAD_URL_TEMPLATE,
+		),
+		TargetKind::Cli => get_env_or(
+			"VSCODE_CLI_CLI_DOWNLOAD_URL_TEMPLATE",
+			VSCODE_CLI_CLI_DOWNLOAD_URL_TEMPLATE,
+		),
+		TargetKind::Archive => None,
+	}
+	.ok_or(CodeError::UpdatesNotConfigured("no download url template"))
+}
+
+fn get_placeholder_value(placeholder: &str, release: &Release) -> Option<String> {
+	let is_built_commit = VSCODE_CLI_COMMIT == Some(release.commit.as_str());
+
+	match placeholder {
+		"os" => Some(release.platform.os()),
+		"arch" => Some(release.platform.arch()),
+		"commit" => Some(release.commit.clone()),
+		"quality" => Some(quality_download_segment(release.quality).to_string()),
+		"release" => match VSCODE_CLI_RELEASE.filter(|value| !value.is_empty()) {
+			Some(built_release) if is_built_commit => Some(built_release.to_string()),
+			_ if !release.name.is_empty() => Some(release.name.clone()),
+			_ => None,
+		},
+		"version" if is_built_commit => VSCODE_CLI_VERSION
+			.filter(|value| !value.is_empty())
+			.map(|version| version.to_string()),
+		_ => None,
+	}
+}
+
+fn expand_download_url_template(template: &str, release: &Release) -> Result<String, WrappedError> {
+	let mut url = String::new();
+	let mut remaining = template;
+
+	while let Some(start) = remaining.find("${") {
+		let length = remaining[start..].find('}').ok_or_else(|| {
+			wrap(
+				template,
+				"unterminated placeholder in the download url template",
+			)
+		})?;
+		let placeholder = &remaining[start + 2..start + length];
+		let value = get_placeholder_value(placeholder, release).ok_or_else(|| {
+			wrap(
+				template,
+				format!(
+					"cannot expand ${{{}}} for commit {} in the download url template",
+					placeholder, release.commit
+				),
+			)
+		})?;
+
+		url.push_str(&remaining[..start]);
+		url.push_str(&value);
+		remaining = &remaining[start + length + 1..];
+	}
+
+	url.push_str(remaining);
+
+	Ok(url)
+}
